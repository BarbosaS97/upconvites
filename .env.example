# Copie este arquivo para ".env" (uso local) e/ou configure as mesmas
# variáveis nas "Environment Variables" do projeto na Vercel.
# NUNCA coloque os valores reais neste arquivo (.env.example fica no git).

# Painel do Supabase > Project Settings > API
SUPABASE_URL=https://frlbmojyjzymyiyzcdrp.supabase.co

# Painel do Supabase > Project Settings > API > "service_role" (secreta!
# nunca exponha no navegador nem comite o valor real em lugar nenhum)
SUPABASE_SERVICE_ROLE_KEY=

# Senha única para entrar no painel /admin
ADMIN_PASSWORD=

# Texto aleatório e longo, só para assinar o cookie de sessão do admin.
# Gere um novo com, por exemplo: openssl rand -hex 32
SESSION_SECRET=
